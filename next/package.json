{
  "name": "livelift-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3130",
    "build": "next build --webpack",
    "start": "next start -p 3130",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:ops": "node scripts/build-ops.mjs",
    "ops": "npm run build:ops --silent && node .ops/scripts/ops.js",
    "test:platform": "vitest run src/lib/server/platform.test.ts",
    "test:platform-live": "node scripts/platform-smoke.mjs",
    "test:phase2-live": "npm run build:ops --silent && node scripts/phase2-live.mjs",
    "test:provider-fixtures": "node acceptance/provider-fixtures.mjs",
    "soak:smoke": "node acceptance/soak.mjs --mode smoke",
    "soak:48h": "node acceptance/soak.mjs --mode rehearsal_48h"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remixicon": "^4.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.16 <23 || >=24"
  }
}
