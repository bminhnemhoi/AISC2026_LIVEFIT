ading-6 text-[#C8CDD6]\" data-kid=\"1-1-3-1-2-2-4\"><i data-name=\"Functional arrow-left-right-line icon\" class=\"ri-arrow-left-right-line\" aria-hidden=\"true\" data-kid=\"1-1-3-1-2-2-4-1\"></i><span data-name=\"Status text\" class=\"\" data-kid=\"1-1-3-1-2-2-4-2\">Overridden</span></span></div></div><div data-name=\"Independent semantic dimension Execution\" class=\"rounded-[12px] bg-[#13161C] p-5\" data-kid=\"1-1-3-1-3\"><h2 data-name=\"Heading\" class=\"text-[22px] leading-[1.2] font-medium tracking-[-0.6px]\" data-kid=\"1-1-3-1-3-1\">Execution</h2><div data-name=\"Region\" class=\"flex flex-wrap gap-x-5 gap-y-3 mt-4\" data-kid=\"1-1-3-1-3-2\"><span data-name=\"Attempted status\" class=\"inline-flex items-center gap-2 text-[16px] leading-6 text-[#C8CDD6]\" data-kid=\"1-1-3-1-3-2-1\"><i data-name=\"Functional cursor-line icon\" class=\"ri-cursor-line\" aria-hidden=\"true\" data-kid=\"1-1-3-1-3-2-1-1\"></i><span data-name=\"Status text\" class=\"\" data-kid=\"1-1-3-1-3-2-1-2\">Attempted</span></span><span data-name=\"Operator reported status\" class=\"inline-flex items-center gap-2 text-[16px] leading-6 text-[#C8CDD6]\" data-kid=\"1-1-3-1-3-2-2\"><i data-name=\"Functional hand-heart-line icon\" class=\"ri-hand-heart-line\" aria-hidden=\"true\" data-kid=\"1-1-3-1-3-2-2-1\"></i><span data-name=\"Status text\" class=\"\" data-kid=\"1-1-3-1-3-2-2-2\">Operator reported</span></span></div></div><div data-name=\"Independent semantic dimension Evidence\" class=\"rounded-[12px] bg-[#13161C] p-5\" data-kid=\"1-1-3-1-4\"><h2 data-name=\"Heading\" class=\"text-[22px] leading-[1.2] font-medium tracking-[-0.6px]\" data-kid=\"1-1-3-1-4-1\">Evidence</h2><div data-name=\"Region\" class=\"flex flex-wrap gap-x-5 gap-y-3 mt-4\" data-kid=\"1-1-3-1-4-2\"><span data-name=\"Observed status\" class=\"inline-flex items-center gap-2 text-[16px] leading-6 text-[#C8CDD6]\" data-kid=\"1-1-3-1-4-2-1\"><i data-name=\"Functional eye-line icon\" class=\"ri-eye-line\" aria-hidden=\"true\" data-kid